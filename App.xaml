<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SortAndDelete"
             xmlns:conv="clr-namespace:SortAndDelete.Converters"
             x:Class="SortAndDelete.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertedBoolConverter x:Key="InvertedBool" />
            <conv:IsNotNullConverter x:Key="IsNotNull" />
            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmpty" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
