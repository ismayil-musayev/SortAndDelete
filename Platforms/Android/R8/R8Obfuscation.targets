<Project>
  <!--
    R8 obfuscation for Release Android builds (imported by SortAndDelete.csproj).

    The SDK's R8 task writes its keep rules to obj\...\proguard\proguard_xamarin.cfg starting with
    -dontobfuscate, which R8 cannot undo. R8 only reads the files in @(_ProguardConfiguration),
    though: _CalculateProguardConfigurationFiles (Xamarin.Android.Common.targets) builds that list
    and _CompileToDalvik (Xamarin.Android.D8.targets) hands it to the R8 task as
    ProguardConfigurationFiles, the only config files the task passes on to R8. So in between,
    swap the SDK's file for:
      proguard_xamarin.cfg             the same keep rules without -dontobfuscate
      obfuscation.cfg                  app-owned rules
      proguard_obfuscation.cfg (obj)   what the task appends to its copy, plus keeps for what
                                       JNI reaches that the SDK's rules leave out (below)
    and make sure every AAR's consumer rules are in the list. The last target works around an
    SDK packaging bug that is independent of R8.
  -->

  <!-- Writes the generated rules. The SDK's keeps (proguard_project_references.cfg for the bound
       Java types managed code uses, proguard_project_primary.cfg for the Java callable wrappers)
       were written for a build that renames nothing, and have gaps once R8 obfuscates:
       - Fields. Managed code reads and writes Java fields by name through JNI (e.g.
         RecyclerView.ViewHolder.ItemView is "itemView"), and no field is kept. Bindings expose
         only public and protected fields, so keep those names.
       - Interface methods. Their keeps come from [Register] on managed methods, but for an
         interface the [Register]ed type is its Invoker class, whose methods carry none, so the
         interface's member list is empty (e.g. kotlin.coroutines.CoroutineContext.get). Keep
         the method names of listed interfaces; the rule matches nothing on classes.
       - Signatures. JNI looks a member up by name *and* signature, and wrappers register their
         native methods the same way, so the classes in those signatures must keep their names
         too. An interface whose Invoker was trimmed gets no keep at all, yet can still appear in
         one (CoroutineContext.get returns CoroutineContext$Element). Repeat the SDK's keeps with
         includedescriptorclasses, which keeps the names of the types in the kept members.
       The field and interface rules use -keepclassmembernames: they stop renaming only, so R8
       still drops what it dropped before obfuscation.
       Not a JNI gap, but the same kind of name lookup: the package gets META-INF/services files
       straight from the jars, not R8's renamed copies, so ServiceLoader finds a provider only if
       the service interface and the provider keep their names (kotlinx.coroutines finds
       Dispatchers.Main that way). -->
  <UsingTask TaskName="SdWriteObfuscationRules" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ReferencesConfig ParameterType="System.String" Required="true" />
      <AcwMapFile ParameterType="System.String" Required="true" />
      <JavaLibraries ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <MappingFile ParameterType="System.String" />
      <IgnoreWarnings ParameterType="System.Boolean" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var lines = new List<string> { "# Generated by Platforms/Android/R8/R8Obfuscation.targets. Do not edit." };
        if (IgnoreWarnings)
            lines.Add("-ignorewarnings");
        if (!string.IsNullOrEmpty(MappingFile))
            lines.Add("-printmapping \"" + MappingFile + "\"");

        // proguard_project_references.cfg: "-keep class X", then "-keepclassmembers class X {",
        // one member per line, "}".
        var classes = new SortedSet<string>(StringComparer.Ordinal);
        string block = null;
        var members = new List<string>();
        foreach (var raw in File.ReadLines(ReferencesConfig))
        {
            var line = raw.Trim();
            if (block == null && line.StartsWith("-keep class ", StringComparison.Ordinal) && line.IndexOf('{') < 0)
                classes.Add(line.Substring("-keep class ".Length).Trim());
            else if (block == null && line.StartsWith("-keepclassmembers class ", StringComparison.Ordinal) && line.EndsWith("{"))
            {
                block = line.Substring("-keepclassmembers class ".Length).TrimEnd('{').Trim();
                members.Clear();
            }
            else if (block != null && line == "}")
            {
                if (members.Count > 0)
                    lines.Add("-keepclassmembers,includedescriptorclasses class " + block + " { " + string.Join(" ", members) + " }");
                block = null;
            }
            else if (block != null && line.Length > 0)
                members.Add(line);
        }
        foreach (var name in classes)
        {
            lines.Add("-keepclassmembernames,includedescriptorclasses class " + name + " { public <fields>; protected <fields>; }");
            lines.Add("-keepclassmembernames,includedescriptorclasses interface " + name + " { <methods>; }");
        }

        // acw-map.txt: "managed name;java name" lines, the list the R8 task turns into
        // proguard_project_primary.cfg ("-keep class <java name> { *; }").
        var wrappers = new SortedSet<string>(StringComparer.Ordinal);
        foreach (var raw in File.ReadLines(AcwMapFile))
        {
            var i = raw.LastIndexOf(';');
            if (i > 0 && i < raw.Length - 1)
                wrappers.Add(raw.Substring(i + 1).Trim());
        }
        foreach (var name in wrappers)
            lines.Add("-keep,includedescriptorclasses class " + name + " { *; }");

        // META-INF/services/<interface> lists one provider class per line ('#' starts a comment).
        var services = new SortedSet<string>(StringComparer.Ordinal);
        var providers = new SortedSet<string>(StringComparer.Ordinal);
        var jars = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var item in JavaLibraries ?? new ITaskItem[0])
        {
            var jar = item.GetMetadata("FullPath");
            if (!jar.EndsWith(".jar", StringComparison.OrdinalIgnoreCase) || !jars.Add(jar) || !File.Exists(jar))
                continue;
            try
            {
                using (var zip = new ZipArchive(File.OpenRead(jar), ZipArchiveMode.Read))
                {
                    foreach (var entry in zip.Entries)
                    {
                        if (!entry.FullName.StartsWith("META-INF/services/", StringComparison.Ordinal) || entry.Name.Length == 0)
                            continue;
                        services.Add(entry.Name);
                        using (var reader = new StreamReader(entry.Open()))
                        {
                            string raw;
                            while ((raw = reader.ReadLine()) != null)
                            {
                                var hash = raw.IndexOf('#');
                                var provider = (hash >= 0 ? raw.Substring(0, hash) : raw).Trim();
                                if (provider.Length > 0)
                                    providers.Add(provider);
                            }
                        }
                    }
                }
            }
            catch (InvalidDataException e)
            {
                Log.LogError(null, "SD0004", null, jar, 0, 0, 0, 0,
                    "R8 obfuscation: could not read this jar to keep its META-INF/services providers ({0}). A provider R8 renames or removes is one ServiceLoader cannot find, which crashes the app at runtime. Restore or replace the jar (a clean Release build re-extracts AAR jars), then build again.",
                    e.Message);
            }
        }
        foreach (var name in services)
            lines.Add("-keepnames class " + name);
        foreach (var name in providers)
            lines.Add("-keep class " + name + " { <init>(); }");

        // Nothing parsed means the SDK changed one of these formats, and the keeps above are gone.
        if (classes.Count == 0 || wrappers.Count == 0)
            Log.LogError(null, "SD0003", null, null, 0, 0, 0, 0,
                "R8 obfuscation: read {0} bound types from {1} and {2} callable wrappers from {3}. The .NET Android SDK has probably changed the format of these files, so the keep rules generated from them are missing and the obfuscated app would crash at runtime. Update the parsing in Platforms\\Android\\R8\\R8Obfuscation.targets for the new format, then build again.",
                classes.Count, ReferencesConfig, wrappers.Count, AcwMapFile);

        // A Fragment task returns true unless it says otherwise, even after logging an error, and the
        // build would then go on to package the app. Fail here, before writing an incomplete file.
        if (Log.HasLoggedErrors)
            return false;

        var text = string.Join("\n", lines) + "\n";
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
            File.WriteAllText(OutputFile, text);
        Log.LogMessage(MessageImportance.Normal, "R8 obfuscation: generated keeps for {0} bound types, {1} callable wrappers and {2} service providers.", classes.Count, wrappers.Count, providers.Count);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Compares the SDK's rules with the project copy, ignoring comments and the lines the R8 task
       appends after its embedded resource. -->
  <UsingTask TaskName="SdCompareXamarinRules" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SdkRules ParameterType="System.String" Required="true" />
      <ProjectRules ParameterType="System.String" Required="true" />
      <Differences ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, bool, List<string>> rules = (path, isSdk) => File.ReadLines(path)
            .Select(l => (l.IndexOf('#') >= 0 ? l.Substring(0, l.IndexOf('#')) : l).Trim())
            .Where(l => l.Length > 0)
            .Where(l => !isSdk || !(l == "-dontobfuscate" || l == "-ignorewarnings"
                || l == "-keepattributes SourceFile" || l == "-keepattributes LineNumberTable"
                || l.StartsWith("-printmapping", StringComparison.Ordinal)))
            .ToList();
        var sdk = rules(SdkRules, true);
        var project = rules(ProjectRules, false);
        if (!sdk.SequenceEqual(project))
        {
            var changes = sdk.Except(project).Select(l => "+ " + l)
                .Concat(project.Except(sdk).Select(l => "- " + l))
                .ToList();
            Differences = changes.Count > 0 ? string.Join(" | ", changes) : "same rules in a different order";
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_SdUseObfuscatingXamarinRules"
          AfterTargets="_CalculateProguardConfigurationFiles"
          Condition=" '$(AndroidLinkTool)' == 'r8' ">
    <PropertyGroup>
      <_SdSdkXamarinRules>$(IntermediateOutputPath)proguard\proguard_xamarin.cfg</_SdSdkXamarinRules>
      <_SdSdkXamarinRulesFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_SdSdkXamarinRules)'))</_SdSdkXamarinRulesFullPath>
      <_SdProjectXamarinRules>$(MSBuildThisFileDirectory)proguard_xamarin.cfg</_SdProjectXamarinRules>
      <_SdAppRules>$(MSBuildThisFileDirectory)obfuscation.cfg</_SdAppRules>
      <_SdGeneratedRules>$(IntermediateOutputPath)proguard\proguard_obfuscation.cfg</_SdGeneratedRules>
      <_SdMappingFile Condition=" '$(AndroidProguardMappingFile)' != '' ">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(AndroidProguardMappingFile)'))</_SdMappingFile>
      <!-- R8 reruns only when its inputs change; make edits to these files count. -->
      <_CompileToDalvikInputs>$(_CompileToDalvikInputs);$(_SdProjectXamarinRules);$(_SdAppRules);$(MSBuildThisFileFullPath)</_CompileToDalvikInputs>
    </PropertyGroup>

    <!-- The R8 task only warns about a missing config file and carries on, which here would
         silently drop the SDK's keep rules. -->
    <Error Condition=" !Exists('$(_SdProjectXamarinRules)') Or !Exists('$(_SdAppRules)') "
           Text="R8 obfuscation: $(_SdProjectXamarinRules) or $(_SdAppRules) is missing." />
    <Error Condition=" '$(_ProguardProjectConfiguration)' == '' Or !Exists('$(_ProguardProjectConfiguration)') "
           Text="R8 obfuscation: the SDK's generated proguard_project_references.cfg was not found ('$(_ProguardProjectConfiguration)')." />
    <Error Condition=" '$(_AcwMapFile)' == '' Or !Exists('$(_AcwMapFile)') "
           Text="R8 obfuscation: the SDK's acw-map.txt was not found ('$(_AcwMapFile)')." />

    <!-- _CompileToDalvik creates this folder itself, but only after this target, on a clean build. -->
    <MakeDir Directories="$(IntermediateOutputPath)proguard" />
    <SdWriteObfuscationRules ReferencesConfig="$(_ProguardProjectConfiguration)"
                             AcwMapFile="$(_AcwMapFile)"
                             JavaLibraries="@(_JavaLibrariesToCompileForApp);@(AndroidJavaLibrary);@(ExtractedJarImports)"
                             MappingFile="$(_SdMappingFile)"
                             IgnoreWarnings="$(AndroidR8IgnoreWarnings)"
                             OutputFile="$(_SdGeneratedRules)" />

    <ItemGroup>
      <_ProguardConfiguration Remove="$(_SdSdkXamarinRules)" />
      <_ProguardConfiguration Include="$(_SdProjectXamarinRules);$(_SdAppRules);$(_SdGeneratedRules)" />
      <FileWrites Include="$(_SdGeneratedRules)" />

      <!-- ResolveLibraryProjectImports reports an AAR's proguard.txt only when it (re)extracts the
           AAR, so an incremental build that reruns it (csproj edit, changed build property) loses
           the AAR consumer rules. The AndroidX packages ship copies separately; Glide's exist only
           in its AAR. Add back any that are missing. -->
      <_SdAarRules Include="@(_ExtractedDirectories->'%(FullPath)\$(_LibraryProjectImportsDirectoryName)\proguard.txt')" />
      <_SdAarRules Remove="@(_SdAarRules)" Condition=" !Exists('%(FullPath)') " />
      <_SdAarRules Remove="@(_ProguardConfiguration)" />
      <_ProguardConfiguration Include="@(_SdAarRules)" />

      <_SdStillDontObfuscate Include="@(_ProguardConfiguration)" Condition=" '%(FullPath)' == '$(_SdSdkXamarinRulesFullPath)' " />
    </ItemGroup>

    <!-- If the SDK ever lists its file differently, the Remove above misses and R8 still sees
         -dontobfuscate. Nothing crashes, but the bundle is not obfuscated and fails Google Play's
         threshold, so stop the build. -->
    <Error Condition=" '@(_SdStillDontObfuscate)' != '' " Code="SD0002"
           Text="R8 obfuscation is OFF: the SDK's proguard_xamarin.cfg (with -dontobfuscate) is still passed to R8, as '@(_SdStillDontObfuscate)'. The SDK now lists it differently from '$(_SdSdkXamarinRules)'; update the Remove in Platforms\Android\R8\R8Obfuscation.targets to match, then build again." />
  </Target>

  <!-- After R8 runs, the obj copy holds the SDK's current rules: fail if they no longer match ours,
       so an SDK update can't silently add or drop keep rules. -->
  <Target Name="_SdCheckSdkXamarinRules"
          AfterTargets="_CompileToDalvik"
          Condition=" '$(AndroidLinkTool)' == 'r8' And Exists('$(IntermediateOutputPath)proguard\proguard_xamarin.cfg') ">
    <SdCompareXamarinRules SdkRules="$(IntermediateOutputPath)proguard\proguard_xamarin.cfg"
                           ProjectRules="$(MSBuildThisFileDirectory)proguard_xamarin.cfg">
      <Output TaskParameter="Differences" PropertyName="_SdXamarinRulesDiff" />
    </SdCompareXamarinRules>
    <Error Condition=" '$(_SdXamarinRulesDiff)' != '' " Code="SD0001"
           Text="The .NET Android SDK's R8 rules (obj\...\proguard\proguard_xamarin.cfg) differ from Platforms\Android\R8\proguard_xamarin.cfg, so keep rules the SDK now relies on may be missing from the obfuscated build. Copy the new rules over, minus -dontobfuscate, re-test the Release build, then build again. Changes: $(_SdXamarinRulesDiff)" />
  </Target>

  <!-- Workaround for an SDK packaging bug that hits Release builds with or without R8: when
       BuildArchive updates an existing base.zip, it skips the jar resources the archive already
       holds (META-INF/services/...) and then deletes them as "no longer required", so every other
       incremental build ships without them, and kotlinx.coroutines then has no Dispatchers.Main.
       Same Inputs/Outputs as _BuildApkEmbed, so whenever that repackages it starts from a fresh
       archive, as a clean build does. -->
  <Target Name="_SdFreshPackageArchive"
          BeforeTargets="_BuildApkEmbed"
          Inputs="$(_BuildApkEmbedInputs)"
          Outputs="$(_BuildApkEmbedOutputs)"
          Condition=" '$(EmbedAssembliesIntoApk)' == 'True' ">
    <Delete Condition=" '$(AndroidPackageFormat)' == 'aab' " Files="$(_BaseZipIntermediate)" />
    <Delete Condition=" '$(AndroidPackageFormat)' != 'aab' " Files="$(ApkFileIntermediate)" />
  </Target>
</Project>
