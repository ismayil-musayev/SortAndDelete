<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>SortAndDelete</RootNamespace>

		<!-- Core and Tests are sibling projects living under this folder — keep their
		     sources out of the app project's default compile globs. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);Core\**;Tests\**</DefaultItemExcludes>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance. -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Sort &amp; Delete</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.ismayil.sortanddelete</ApplicationId>

		<!-- Versions: bump ApplicationVersion (Play versionCode) on every Play upload -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- iOS 15+: Photos framework limited-access APIs; Android 10 (29)+: scoped storage.
		     The system trash (30-day auto purge) requires Android 11 (API 30)+;
		     on Android 10 emptying the bin deletes permanently after an extra warning. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#5B44D8" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#5B44D8" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- Keeps the platform-native sqlite binaries in the app package (sqlite-net comes via Core). -->
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="Core\SortAndDelete.Core.csproj" />
	</ItemGroup>

	<!-- Release signing for Google Play. The signing/ folder is gitignored — it holds the
	     upload keystore and passwords. BACK IT UP somewhere safe (password manager). -->
	<Import Project="signing\signing.props" Condition="Exists('signing\signing.props')" />

	<ItemGroup>
		<!-- CVE-2025-6965 (SQLite aggregate-term truncation) in the bundled e_sqlite3 native lib.
		     No patched SQLitePCLRaw release exists yet (all <= 2.1.11 affected). Exploitation
		     requires executing attacker-crafted SQL; this app only runs fixed, parameterized
		     queries against its own private local database, so the vulnerable path is not
		     reachable. Remove this suppression when SQLitePCLRaw ships a fixed version. -->
		<NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
	</ItemGroup>

</Project>
